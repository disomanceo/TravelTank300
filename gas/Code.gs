function doPost(e){try{var action=String(e.parameter.action||'');var token=String(e.parameter.token||'');if(token!==PropertiesService.getScriptProperties().getProperty('UPLOAD_TOKEN'))throw new Error('Unauthorized');var data=JSON.parse(String(e.parameter.data||'{}'));if(action==='uploadBatchV2')return json_({success:true,files:uploadBatchV2_(data)});if(action==='delete')return json_({success:true,deleted:deleteImage_(data.fileId)});if(action==='getImage')return json_({success:true,image:getImage_(data.fileId)});throw new Error('Unknown action');}catch(err){return json_({success:false,message:String(err&&err.message||err)});}}
function uploadBatchV2_(payload){var root=DriveApp.getFolderById(PropertiesService.getScriptProperties().getProperty('ROOT_FOLDER_ID'));var folder=getOrCreate_(root,String(payload.groupId||new Date().getTime()));return(payload.files||[]).map(function(item){var original=folder.createFile(Utilities.newBlob(Utilities.base64Decode(item.originalBase64),item.mimeType,item.fileName));var preview=folder.createFile(Utilities.newBlob(Utilities.base64Decode(item.previewBase64),'image/jpeg','preview-'+item.fileName.replace(/\.[^.]+$/,'')+'.jpg'));original.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);preview.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);return{driveFileId:original.getId(),driveUrl:'https://drive.google.com/uc?export=view&id='+original.getId(),thumbnailUrl:'https://drive.google.com/thumbnail?id='+preview.getId()+'&sz=w1120',fileName:item.fileName,mimeType:item.mimeType};});}
function deleteImage_(id){if(!id)return false;DriveApp.getFileById(id).setTrashed(true);return true;}
function getImage_(id){var b=DriveApp.getFileById(id).getBlob();return{base64:Utilities.base64Encode(b.getBytes()),mimeType:b.getContentType()};}
function getOrCreate_(parent,name){var it=parent.getFoldersByName(name);return it.hasNext()?it.next():parent.createFolder(name);}
function json_(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON);}
